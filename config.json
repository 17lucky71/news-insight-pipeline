{
  "database": {
    "path": "data/news.db"
  },
  "logging": {
    "level": "INFO",
    "file": "logs/app.log"
  },
  "http": {
    "timeout": 10,
    "max_retries": 2,
    "request_delay": 1.0,
    "user_agent": "Mozilla/5.0 (news-insight-pipeline; educational project)"
  },
  "default_source": "yonhap",
  "sources": {
    "yonhap": {
      "name": "연합뉴스",
      "rss": {
        "경제": "https://www.yna.co.kr/rss/economy.xml",
        "산업": "https://www.yna.co.kr/rss/industry.xml",
        "사회": "https://www.yna.co.kr/rss/society.xml",
        "국제": "https://www.yna.co.kr/rss/international.xml",
        "문화": "https://www.yna.co.kr/rss/culture.xml"
      },
      "article_selectors": [
        "div.story-news.article p",
        "article.story-news p",
        "div#articleWrap p",
        "article p"
      ]
    }
  },
  "duplicate_policy": "skip",
  "ai": {
    "provider": "gemini",
    "model": "gemini-2.5-flash",
    "fallback_models": [
      "gemini-2.5-flash-lite",
      "gemini-flash-latest"
    ],
    "api_key_env": "GEMINI_API_KEY",
    "max_input_chars": 4000,
    "timeout": 60,
    "max_retries": 2,
    "request_delay": 4.0,
    "max_analysis_chars": 30000
  },
  "output": {
    "report_dir": "output/reports",
    "chart_dir": "output/charts",
    "export_dir": "output/exports"
  }
}
